{
  "name": "heart-probability-lab",
  "private": true,
  "version": "1.0.0",
  "description": "匿名、本地计算、基于透明统计模型的轻娱乐择偶条件分析工具。",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:model": "vitest run tests/model tests/data tests/performance",
    "test:e2e": "playwright test",
    "validate:model": "tsx scripts/validate-model.ts",
    "generate:evidence-runtime": "tsx scripts/generate-evidence-runtime.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "scan:dist": "tsx scripts/scan-dist.ts",
    "check:fast": "npm run scan:secrets && npm run typecheck && npm run lint && npm run test && npm run validate:model && npm run build && npm run scan:dist",
    "check": "npm run check:fast && npm run test:e2e && npm run audit:prod"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "^0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
